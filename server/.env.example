# MongoDB connection string (MongoDB Atlas free M0 works)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/pulseboard
# Long random string used to sign login tokens
JWT_SECRET=
# Where the React app is hosted (for CORS, invite links and Stripe redirects)
APP_URL=http://localhost:5173

# Optional: Stripe test mode for PulseBoard's own plans
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional tuning
# DEMO_TTL_HOURS=24
# DEMO_PER_HOUR=8
# SIMULATOR_SECONDS=3
